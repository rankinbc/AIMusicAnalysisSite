# SPECTR — canonical config/secret inventory (story 4.1 / AR40 / NFR6)
# Copy to .env (gitignored) and fill in. PLACEHOLDERS ONLY in this file.
# Three consumers read these:
#   * docker compose (docker/docker-compose.yml) — the ${VAR} substitutions
#   * BFF (ASP.NET) — double-underscore form maps to config sections (Jwt__Key -> Jwt:Key)
#   * worker (python) — flat names via os.environ / pydantic-settings
#
# SECRETS ARE REQUIRED IN PRODUCTION: the BFF refuses to boot outside
# Development without Jwt__Key and Anon__SigningKey (32+ random bytes each).
# Generate: openssl rand -base64 48

# ── Environment ──────────────────────────────────────────────────────────────
# Load-bearing since story 4.1: Development loads the committed dev signing
# keys; every other environment REQUIRES real keys or the BFF refuses to boot.
# (The boot check also rejects these REPLACE_* placeholders — you must
# generate real values.)
ASPNETCORE_ENVIRONMENT=Development

# ── Compose-level ────────────────────────────────────────────────────────────
# Required by docker compose (fails fast without it) AND the BFF in prod.
# NOTE: JWT_KEY (compose substitution) and Jwt__Key (direct BFF env) are the
# SAME logical secret — if you set both forms, they MUST be equal.
JWT_KEY=REPLACE_WITH_32_PLUS_RANDOM_BYTES
ANON_SIGNING_KEY=REPLACE_WITH_32_PLUS_RANDOM_BYTES_DIFFERENT_FROM_JWT

# Anthropic API key for the LLM gateway. Empty + LLM_FAKE=1 = no-key dev mode.
ANTHROPIC_API_KEY=
LLM_FAKE=1

# ── BFF (ASP.NET double-underscore form) ─────────────────────────────────────
# Signing keys (NFR6 launch blockers — 32+ bytes, boot-validated):
Jwt__Key=REPLACE_WITH_32_PLUS_RANDOM_BYTES
Anon__SigningKey=REPLACE_WITH_32_PLUS_RANDOM_BYTES_DIFFERENT_FROM_JWT

ConnectionStrings__Postgres=Host=localhost;Port=5432;Database=spectr;Username=spectr;Password=REPLACE_ME
Redis__ConnectionString=localhost:6379

# Object storage (MinIO dev / Cloudflare R2 prod — AR17/AR21):
Storage__Provider=local
Storage__S3__ServiceUrl=http://localhost:9000
Storage__S3__AccessKey=REPLACE_ME
Storage__S3__SecretKey=REPLACE_ME
Storage__S3__Bucket=spectr
Storage__S3__Region=auto
Storage__S3__ForcePathStyle=true
Storage__S3__UrlExpiryMinutes=120
Storage__S3__ReadUrlExpiryMinutes=15

# Stripe (empty in dev = billing endpoints return stripe_not_configured;
# SPECTR_REQUIRE_STRIPE=1 makes missing values a boot failure — set in prod):
SPECTR_REQUIRE_STRIPE=0
Stripe__SecretKey=
Stripe__WebhookSecret=
Stripe__PriceProMonthly=
Stripe__PriceProAnnual=
Stripe__PriceCreditPack5=
Stripe__PriceCreditPack10=

# Transactional email — Resend (story 4.2 / AR27 / NFR25). Empty in dev =
# the send_email actor logs instead of sending. SPECTR_REQUIRE_EMAIL=1 makes
# missing values a boot failure — set in prod. DNS checklist: docs/runbook.md.
SPECTR_REQUIRE_EMAIL=0
Resend__ApiKey=
Resend__WebhookSecret=
Resend__FromAddress=SPECTR <onboarding@resend.dev>

# Worker supervision (story 3.5 / NFR16):
Worker__StaleJobMinutes=30
Worker__PendingGraceMinutes=240
Worker__HeartbeatStaleSeconds=60

# Coach caps (FR15) + retention driver (story 3.4):
CoachCaps__FreeFollowups=3
Retention__Enabled=true
Retention__LapsedDays=90
Retention__InitialDelayMinutes=5

App__FrontendOrigin=http://localhost:5174

# Auth rate limits (story 4.3 / NFR8): enforced by default everywhere except
# Development (appsettings.Development.json turns them off for the test
# suite). Set false only for load-testing environments.
RateLimits__Enabled=true

# ── Worker (python, flat names) ──────────────────────────────────────────────
DATABASE_URL=postgresql+psycopg2://spectr:REPLACE_ME@localhost:5432/spectr
REDIS_URL=redis://localhost:6379/0

# Object storage (worker-OWN credentials — AR21, never the BFF's):
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=REPLACE_ME
S3_SECRET_KEY=REPLACE_ME
S3_BUCKET=spectr
S3_REGION=auto

# Retention sweep (story 3.4 / AR40):
RETENTION_FREE_DAYS=30
RETENTION_LAPSED_DAYS=90
RETENTION_ANON_HOURS=72

# LLM gateway (story 1.3/1.4 — full list in components/worker/.env.example):
LLM_MAX_CONCURRENCY=5
LLM_COACH_CONCURRENCY=2
LLM_BUDGET_FREE_USD=5.00
LLM_BUDGET_PRO_USD=100.00
LLM_BUDGET_GLOBAL_USD=1000.00

COACH_FREE_FOLLOWUPS=3

# Transactional email (story 4.2): worker-side Resend key for the send_email
# actor. Empty = stub mode (logs, no sends).
RESEND_API_KEY=

# ML model cache under the repo, not ~/.cache (project rule):
TORCH_HOME=data/models

# ── Production-only (story 10.1 — /opt/spectr/.env on the VPS, chmod 600) ──
# Consumed by infra/compose.prod.yml; the compose refuses to start with any
# of these missing (:? substitution). Never set these in dev.
# SPECTR_DOMAIN=spectr.example.com
# IMAGE_TAG=              (managed by deploy.sh — do not set by hand)
# POSTGRES_PASSWORD=
# R2_ENDPOINT=https://<account>.r2.cloudflarestorage.com
# R2_BUCKET=spectr
# R2_BFF_ACCESS_KEY=      (scoped token #1)
# R2_BFF_SECRET_KEY=
# R2_WORKER_ACCESS_KEY=   (scoped token #2 — AR21, never share with BFF)
# R2_WORKER_SECRET_KEY=
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=
# STRIPE_PRICE_PRO_MONTHLY=
# STRIPE_PRICE_PRO_ANNUAL=
# RESEND_WEBHOOK_SECRET=
# RESEND_FROM=SPECTR <noreply@yourdomain>
# ANON_SIGNING_KEY= / JWT_KEY= / ANTHROPIC_API_KEY= / RESEND_API_KEY= (above)
