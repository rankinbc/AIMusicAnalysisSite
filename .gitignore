# Local Claude scaffold runtime artifacts
.claude/scheduled_tasks.lock

# Loose Playwright screenshots dropped at repo root by browser smoke tests
/*.png
!components/**/*.png

# run logs / generated analysis outputs
*.log.err
data/output/
data/analysis/

# TanStack Router generated cache
**/.tanstack/

# Generated frontend output artifacts
output/frontend-spectr-v2/

# DB dumps (pg_dump backups) — contain user emails + password hashes, never commit
output/db-backups/

# Integration-test-generated upload/als staging dirs (per-run GUID folders)
components/bff/tests/data/audio/
components/bff/tests/data/analysis/

# SDD scratch (any depth)
.superpowers/
**/.superpowers/

# Isolated worktrees for subagent-driven-development tasks
.worktrees/

# Worker/dev runtime logs — written by start-spectr.ps1 + the workerdash watchdog
data/logs/
components/workerdash/.cache/

# BMad workflow tool output (generated session artifacts; keepers get archived to docs/archive/)
_bmad-output/
