# Copy to .env and fill in real values before running.
# Never commit .env to version control.

# --- Database ---
# Async URL for SQLAlchemy 2.0 (asyncpg driver)
DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/aimusicdb

# Sync URL for Alembic migrations ONLY (psycopg2 driver)
ALEMBIC_DATABASE_URL=postgresql+psycopg2://user:password@localhost:5432/aimusicdb

# --- Auth ---
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# --- Redis / Celery ---
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1

# --- Storage ---
# dev = local disk (data/uploads/), prod = s3
STORAGE_BACKEND=local
UPLOAD_DIR=../../data/uploads

# AWS S3 (only needed when STORAGE_BACKEND=s3)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_BUCKET=
AWS_S3_REGION=us-east-1

# --- CORS ---
# Comma-separated explicit origins — never use * with credentials
CORS_ALLOW_ORIGINS=http://localhost:5173

# --- Upload limits ---
MAX_UPLOAD_BYTES=209715200   # 200 MB
ALLOWED_AUDIO_MIME_TYPES=audio/mpeg,audio/flac,audio/wav,audio/x-wav
