<Project>
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <LangVersion>latest</LangVersion>
    <AnalysisLevel>latest</AnalysisLevel>
    <!--
      NuGetAuditMode=direct audits packages we explicitly reference (and any
      that get promoted to direct deps via PackageReference) but skips noisy
      CVEs on transitive 3rd-party packages (e.g. System.Security.Cryptography.Xml
      pulled in by Serilog) that upstream is responsible for patching.
      Reconsider when targeting a NIST-bound deployment.
    -->
    <NuGetAuditMode>direct</NuGetAuditMode>
  </PropertyGroup>
</Project>
