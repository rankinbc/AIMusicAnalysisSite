<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <RootNamespace>Spectr.Bff</RootNamespace>
    <UserSecretsId>spectr-bff</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Spectr.Data\Spectr.Data.csproj" />
    <ProjectReference Include="..\Spectr.Domain\Spectr.Domain.csproj" />
  </ItemGroup>

  <!-- Story 4.1 (NFR6): the dev-only signing keys in appsettings.Development.json
       must never ship in a published image — combined with the boot-time
       dev-key blacklist this closes the env=Development-in-prod bypass. -->
  <ItemGroup>
    <Content Update="appsettings.Development.json" CopyToPublishDirectory="Never" />
  </ItemGroup>

  <!-- Story 2.10: unit tests call internal methods on BillingReconciliationService -->
  <ItemGroup>
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleTo">
      <_Parameter1>Spectr.Bff.Tests</_Parameter1>
    </AssemblyAttribute>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="10.0.0" />
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="10.0.0" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.0" />
    <PackageReference Include="BCrypt.Net-Next" Version="4.0.3" />
    <PackageReference Include="StackExchange.Redis" Version="2.7.33" />
    <PackageReference Include="Serilog.AspNetCore" Version="9.0.0" />
    <PackageReference Include="FluentValidation.AspNetCore" Version="11.3.0" />
    <PackageReference Include="Stripe.net" Version="52.0.0" />
    <PackageReference Include="AWSSDK.S3" Version="4.0.25.2" />
    <!-- Story 10.3 — observability: /metrics + DSN-gated error reporting -->
    <PackageReference Include="prometheus-net.AspNetCore" Version="8.2.1" />
    <PackageReference Include="Sentry.AspNetCore" Version="5.0.1" />
  </ItemGroup>
</Project>
