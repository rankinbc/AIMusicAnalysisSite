REDIS_URL=redis://localhost:6379/0
DATABASE_URL=postgresql+psycopg2://user:password@localhost:5432/aimusicanalysis
DEMUCS_MODEL=htdemucs

# ── LLM gateway (story 1.3) ─────────────────────────────────────────────────
# Anthropic API key. Leave empty + set LLM_FAKE=1 to run with zero spend.
# NEVER commit a real key (NFR6).
ANTHROPIC_API_KEY=

# LLM_FAKE=1 → canned replay, no network, no spend (dev/CI default).
LLM_FAKE=1

# Concurrency: global pool + coach sub-pool (AR6).
LLM_MAX_CONCURRENCY=5
LLM_COACH_CONCURRENCY=2

# Models — confirm the exact API model id for your account.
LLM_DEFAULT_MODEL=claude-sonnet-4-5
LLM_FALLBACK_MODEL=claude-haiku-4-5

# Retry policy (gateway-owned; SDK retries disabled).
LLM_MAX_RETRIES=2
LLM_TIMEOUT_S=120

# ── Budgets + circuit breaker (story 1.4 / AR8 / FR16) ───────────────────────
# Per-tier monthly USD ceilings (Decimal). When spend in the current calendar
# month reaches a tier ceiling, the gateway raises LlmBudgetExceeded PRE-call
# (un-metered) and the actors persist a degradation notice + rule-engine
# verdicts. Budgets auto-reset at the month boundary — no manual intervention.
# Tier strings mirror LlmCall.tier values: "free" until Epic 2 stamps real
# tier on jobs; "pro" lands with billing.
LLM_BUDGET_FREE_USD=5.00
LLM_BUDGET_PRO_USD=100.00
# Operator hard cap across every tier in the current month. Defends against
# a misconfigured tier ceiling burning a card.
LLM_BUDGET_GLOBAL_USD=1000.00

# Provider-outage circuit breaker (in-process; workers run concurrency=1).
# Opens after N consecutive error outcomes; stays open for the cooldown
# window. The first call after cooldown is a probe — closes on success or
# re-opens on failure. Recovery is automatic.
LLM_CIRCUIT_BREAKER_THRESHOLD=5
LLM_CIRCUIT_BREAKER_COOLDOWN_S=300
