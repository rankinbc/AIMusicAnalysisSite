REDIS_URL=redis://localhost:6379/0
DATABASE_URL=postgresql+psycopg2://user:password@localhost:5432/aimusicanalysis
DEMUCS_MODEL=htdemucs

# ── LLM gateway (story 1.3) ─────────────────────────────────────────────────
# Anthropic API key. Leave empty + set LLM_FAKE=1 to run with zero spend.
# NEVER commit a real key (NFR6).
ANTHROPIC_API_KEY=

# LLM_FAKE=1 → canned replay, no network, no spend (dev/CI default).
LLM_FAKE=1

# Concurrency: global pool + coach sub-pool (AR6).
LLM_MAX_CONCURRENCY=5
LLM_COACH_CONCURRENCY=2

# Models — confirm the exact API model id for your account.
LLM_DEFAULT_MODEL=claude-sonnet-4-5
LLM_FALLBACK_MODEL=claude-haiku-4-5

# Retry policy (gateway-owned; SDK retries disabled).
LLM_MAX_RETRIES=2
LLM_TIMEOUT_S=120

# ── Budgets + circuit breaker (story 1.4 / AR8 / FR16) ───────────────────────
# Per-tier monthly USD ceilings (Decimal). When spend in the current calendar
# month reaches a tier ceiling, the gateway raises LlmBudgetExceeded PRE-call
# (un-metered) and the actors persist a degradation notice + rule-engine
# verdicts. Budgets auto-reset at the month boundary — no manual intervention.
# Tier strings mirror LlmCall.tier values: "free" until Epic 2 stamps real
# tier on jobs; "pro" lands with billing.
# Story 2.6 / AR35: these three ceilings are now ALSO operator-tunable LIVE via
# the shared `feature_flags` table (flags `llm_budget_free_usd`,
# `llm_budget_pro_usd`, `llm_budget_global_usd`). The worker re-reads the table
# every ~60 s (app/feature_flags.py), so a flag change takes effect without a
# redeploy. A flag value, when present, OVERRIDES the env value below; absent
# (or a sick metering DB) falls back to these env defaults. The flags are seeded
# equal to these defaults, so the table changes nothing until an operator edits
# it. This is the SPEND half of the two-guard model (the BFF gates coach COUNT).
LLM_BUDGET_FREE_USD=5.00
LLM_BUDGET_PRO_USD=100.00
# Operator hard cap across every tier in the current month. Defends against
# a misconfigured tier ceiling burning a card.
LLM_BUDGET_GLOBAL_USD=1000.00

# Provider-outage circuit breaker (in-process; workers run concurrency=1).
# Opens after N consecutive error outcomes; stays open for the cooldown
# window. The first call after cooldown is a probe — closes on success or
# re-opens on failure. Recovery is automatic.
LLM_CIRCUIT_BREAKER_THRESHOLD=5
LLM_CIRCUIT_BREAKER_COOLDOWN_S=300

# ── Coach prompts (story 1.5 / AR10) ─────────────────────────────────────────
# Directory holding versioned coach prompts (CoachGrounded.md, …). Defaults
# to components/worker/prompts/coach relative to the worker package. Override
# only when running a forked prompt set in dev.
COACH_PROMPTS_DIR=

# ── Coach caps (story 1.9 / 2.6 / UX-DR16 / AR40 / AR35) ─────────────────────
# Story 2.6 moved coach-cap enforcement to the BFF's CoachCapService, which reads
# the caps from the shared `feature_flags` table (NOT this env var) via the
# entitlement resolver:
#   coach_free_followups : per-analysis free-tier cap (flag, seeded 3).
#   coach_pro_monthly    : pooled MONTHLY Pro cap across analyses (flag, seeded 300),
#                          counted from `coach_message` usage_events.
# These flags hot-reload on the BFF within ~60 s. The env var below is now
# vestigial (the IOptions<CoachCapsOptions> binding is retained for back-compat
# but the endpoint no longer reads it). The worker does NOT read coach COUNT caps
# — that gate is the BFF's. Kept here as the canonical knob index (AR40).
COACH_FREE_FOLLOWUPS=3
