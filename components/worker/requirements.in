#   uv pip compile components/worker/requirements.in --universal --python-version 3.11 \
#     -o components/worker/requirements.lock.txt
# Install pattern (CI + Docker):
#   pip install -e components/shared -c components/worker/requirements.lock.txt
#   pip install -e components/analysis -c components/worker/requirements.lock.txt
#   pip install -r components/worker/requirements.txt -c components/worker/requirements.lock.txt
# (aimusic-shared itself is local — intentionally NOT in this lock input.)

