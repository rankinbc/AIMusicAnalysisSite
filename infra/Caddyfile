# Story 10.1 (AR29/D8) — the production edge. Caddy terminates TLS
# (auto-ACME via {$SPECTR_DOMAIN}), serves the SPA + funnel statics, and
# proxies /api + crawler /r/* to the BFF. This REPLACES the dev nginx
# container in prod — the UA-split below is ported from
# components/frontend-spectr-v2/nginx.conf (story 7.2).

# www → apex (a bare CNAME visitor must not hit a TLS error).
www.{$SPECTR_DOMAIN} {
	redir https://{$SPECTR_DOMAIN}{uri} permanent
}

{$SPECTR_DOMAIN} {
	encode zstd gzip
	header Strict-Transport-Security "max-age=31536000; includeSubDomains"

	# Crawlers get the BFF's prerendered OG shell so share links unfurl;
	# humans get the SPA shell (story 7.2 split).
	@share_bots {
		path /r/*
		header_regexp ua User-Agent (?i)(discordbot|slackbot|twitterbot|facebookexternalhit|whatsapp|telegrambot|linkedinbot|googlebot|bingbot|embedly|pinterest|skypeuripreview)
	}
	handle @share_bots {
		reverse_proxy bff:5000
	}

	# Story 6.1 — SOCIAL-PREVIEW bots on the public funnel pages get the BFF
	# meta shell (title/description/OG/canonical); humans fall through to the
	# SPA. Deliberately NOT googlebot/bingbot (unlike @share_bots): search
	# engines index body content, and serving them a two-sentence stub while
	# humans get the real page is thin-content/cloaking — they render the SPA
	# fine. Extend the path list when 6.2 adds trust pages.
	@site_bots {
		path / /pricing /pricing/ /trust/no-training /trust/no-training/ /trust/results-forever /trust/results-forever/ /trust/privacy /trust/privacy/
		header_regexp ua User-Agent (?i)(discordbot|slackbot|twitterbot|facebookexternalhit|whatsapp|telegrambot|linkedinbot|applebot|redditbot|embedly|pinterest|skypeuripreview)
	}
	handle @site_bots {
		reverse_proxy bff:5000
	}

	handle /api/* {
		reverse_proxy bff:5000 {
			# SSE (job/coach streams): no buffering, no idle cutoff.
			flush_interval -1
			transport http {
				read_timeout 24h
			}
		}
	}

	# /healthz for external probes (10.4 healthchecks.io) + deploy smoke.
	handle /healthz {
		reverse_proxy bff:5000
	}

	# Everything else: SPA + funnel statics with far-future caching on
	# hashed assets ("funnel statics via Caddy with cache headers" — D8).
	handle {
		root * /srv
		@assets path /assets/*
		header @assets Cache-Control "public, max-age=31536000, immutable"
		try_files {path} /index.html
		file_server
	}
}
