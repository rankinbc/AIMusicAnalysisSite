# Story 10.1 — the `spectr-web` prod edge image: frontend vite build baked
# into caddy:2 with infra/Caddyfile. Build context = REPO ROOT (needs both
# components/frontend-spectr-v2 and infra/).
FROM node:22-alpine AS build
WORKDIR /app
# Story 10.3 — baked at build time (vite inlines import.meta.env). Empty =
# Sentry/PostHog fully disabled in the bundle.
ARG VITE_SENTRY_DSN=""
ARG VITE_POSTHOG_KEY=""
ENV VITE_SENTRY_DSN=$VITE_SENTRY_DSN \
    VITE_POSTHOG_KEY=$VITE_POSTHOG_KEY
COPY components/frontend-spectr-v2/package*.json ./
RUN npm ci
COPY components/frontend-spectr-v2/ ./
RUN npm run build

# Minor-pinned: the TLS edge must not absorb unreviewed major/minor bumps.
# 2.8 (alpine 3.20) hit Trivy CRITICALs (openssl CVE-2026-31789, embedded
# smallstep CVE-2025-44005) — bumped 2026-07-13.
FROM caddy:2.11
# Same trivy-gate rationale as the worker image: pull alpine base-package
# security updates at build so a stale base layer can't fail the deploy scan.
RUN apk upgrade --no-cache
COPY infra/Caddyfile /etc/caddy/Caddyfile
COPY --from=build /app/dist /srv
